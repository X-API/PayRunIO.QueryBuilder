<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputType>Package</OutputType>

    <!--
      The package version comes from the build server, which owns the numbering:

        -p:PackageVersion=%build.number%

      Windows Installer compares only the first three fields of a version. 1.1.0.5 and
      1.1.0.6 are the same product for upgrade detection, and installing one over the other
      silently does nothing, so a four part value is truncated to three below. The build
      server emits three part numbers, making that a safety net rather than the normal path.
      If it is ever reconfigured to a pattern where only the fourth field moves, every build
      would collapse to the same package version and upgrades would stop working.

      PackageVersion is a separate property rather than passing ProductVersion directly: a
      property set on the command line is global and cannot be adjusted by the project, so a
      four part ProductVersion would reach the compiler untouched and produce exactly the
      broken package described above without failing the build.
    -->
    <PackageVersion Condition="'$(PackageVersion)' == ''">1.1.0</PackageVersion>
    <ProductVersion Condition="'$(ProductVersion)' == '' and $(PackageVersion.Split('.').Length) &gt; 3">$(PackageVersion.Split('.')[0]).$(PackageVersion.Split('.')[1]).$(PackageVersion.Split('.')[2])</ProductVersion>
    <ProductVersion Condition="'$(ProductVersion)' == ''">$(PackageVersion)</ProductVersion>

    <!-- Declared after ProductVersion: MSBuild evaluates properties in order, so naming
         the package before the version is set would produce an unversioned file name. -->
    <OutputName>PayRunIO.QueryBuilder-$(ProductVersion)</OutputName>

    <!-- The version is part of the output file name but not part of the compile's
         up-to-date check: CoreCompile in wix.targets compares source timestamps against
         the bind tracking file, whose name carries no version. Building 1.1.4 and then
         1.1.5 without a clean therefore left the tracking file newer than every input, so
         the compile was skipped and the copy failed with MSB3030 looking for an MSI that
         was never produced. Giving each version its own intermediate directory gives it
         its own tracking file, so a version change always forces a rebuild. -->
    <IntermediateOutputPath>obj\$(Configuration)\$(ProductVersion)\</IntermediateOutputPath>

    <!-- Defaults to the local self contained publish output. CI passes an absolute path. -->
    <PublishRoot Condition="'$(PublishRoot)' == ''">$(MSBuildThisFileDirectory)..\PayRunIO.QueryBuilder\bin\Release\net8.0-windows7.0\win-x64\publish\</PublishRoot>

    <ProjectRoot>$(MSBuildThisFileDirectory)..\PayRunIO.QueryBuilder\</ProjectRoot>

    <!-- Installer owned content such as the branded wizard artwork. -->
    <AssetsRoot>$(MSBuildThisFileDirectory)Assets\</AssetsRoot>

    <DefineConstants>PublishRoot=$(PublishRoot);ProductVersion=$(ProductVersion);ProjectRoot=$(ProjectRoot);AssetsRoot=$(AssetsRoot)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <!-- Provides the WixShellExec custom action used to launch the application from the
         final page of the installer. -->
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

  <!-- Windows Installer never applies the transparent window style to checkbox controls, so
       the launch checkbox on the final page paints a grey block over the white area of the
       branded dialog bitmap. This is a Windows Installer limitation, closed as won't fix
       upstream (wixtoolset/issues#1141). The accepted workaround, applied to the linked
       package here, shrinks the checkbox to the tick box and moves its caption into a
       separate transparent Text control. See Fix-ExitDialogCheckBox.ps1. -->
  <Target Name="FixExitDialogCheckBox" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <BuiltMsiPath>$(OutputPath)$(OutputName).msi</BuiltMsiPath>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)Fix-ExitDialogCheckBox.ps1&quot; -MsiPath &quot;$(BuiltMsiPath)&quot;"
          Condition="Exists('$(BuiltMsiPath)')" />
  </Target>

</Project>
