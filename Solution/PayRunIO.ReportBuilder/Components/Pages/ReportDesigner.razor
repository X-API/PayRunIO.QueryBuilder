@page "/report"
@attribute [Authorize]
@implements IDisposable
@inject PayRunQueryService QueryService
@inject ReportDefinitionService ReportDefinitions
@inject ReportSession Session
@inject ReportSessionStore SessionStore
@inject DesignerModeStore ModeStore
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime

<PageTitle>Report designer — PayRun.io Report Builder</PageTitle>

<div class="designer-grid">
    <section class="chat-pane">
        <ChatPanel @ref="chatPanel"
                   CurrentQueryXml="@Session.QueryXml"
                   LastError="@Session.LastErrorMessage"
                   ShowRql="@ModeStore.IsAdvanced"
                   OnQueryProduced="ApplyQueryFromChat"
                   BusyChanged="OnAssistantBusyChanged" />
    </section>

    <section class="query-pane @(isAssistantBusy ? "assistant-busy" : null)">
        <div class="pane-header">
            <h2>Report</h2>
            <div class="pane-actions">
                <label class="mode-toggle" title="Advanced mode expands the underlying RQL query by default and lets you edit it directly.">
                    <input type="checkbox"
                           checked="@ModeStore.IsAdvanced"
                           disabled="@isAssistantBusy"
                           @onchange="ToggleModeAsync" />
                    <span>Advanced mode</span>
                </label>
                <button class="button primary"
                        @onclick="RunQueryAsync"
                        disabled="@(isRunning || isAssistantBusy || string.IsNullOrWhiteSpace(Session.QueryXml))">
                    @(isRunning ? "Running…" : "Run report")
                </button>
            </div>
        </div>

        <div class="save-bar">
            <label class="save-name">
                <span>Report name</span>
                <input value="@Session.ReportName"
                       placeholder="e.g. Monthly gross to net"
                       disabled="@isAssistantBusy"
                       @onchange="e => Session.ReportName = e.Value?.ToString() ?? string.Empty" />
            </label>
            <button class="button"
                    @onclick="SaveReportAsync"
                    disabled="@(isSaving || isRunning || isAssistantBusy || string.IsNullOrWhiteSpace(Session.QueryXml) || string.IsNullOrWhiteSpace(Session.ReportName))">
                @(isSaving ? "Saving…" : Session.SavedReportId == null ? "Save report" : "Save changes")
            </button>
            @if (saveStatus != null)
            {
                <span class="save-status @(saveStatusIsError ? "error" : "ok")">@saveStatus</span>
            }
        </div>

        @if (Session.Variables.Count > 0)
        {
            <div class="variables-editor">
                <h3>Report parameters</h3>
                <div class="variables-grid">
                    @foreach (var variable in Session.Variables)
                    {
                        <label class="variable-field">
                            <span>@TrimBrackets(variable.Name)</span>
                            <input value="@variable.Value"
                                   disabled="@isAssistantBusy"
                                   @onchange="e => UpdateVariable(variable.Name, e.Value?.ToString() ?? string.Empty)" />
                        </label>
                    }
                </div>
            </div>
        }

        <details class="rql-expando query-expando" open="@ModeStore.IsAdvanced">
            <summary>Report query (RQL)</summary>
            <textarea class="query-editor"
                      spellcheck="false"
                      placeholder="The RQL report query appears here. Ask the assistant to create one, open a common report, or paste your own."
                      disabled="@isAssistantBusy"
                      @bind="QueryXml"></textarea>
        </details>

        @if (!ModeStore.IsAdvanced && string.IsNullOrWhiteSpace(Session.QueryXml))
        {
            <div class="standard-placeholder">
                No report yet — describe the report you need in the assistant panel and it will be built for you.
            </div>
        }
        else if (!ModeStore.IsAdvanced && Session.Result == null)
        {
            <div class="standard-placeholder ready">
                Your report is ready — set any parameters above, then press "Run report".
            </div>
        }

        @if (Session.SessionExpired)
        {
            <div class="banner error">
                <div class="banner-text">@Session.LastErrorMessage</div>
                <button class="button" @onclick="SignInAgainAsync">Sign in again</button>
            </div>
        }
        else if (Session.LastErrorMessage != null)
        {
            <div class="banner error">
                <div class="banner-text">@Session.LastErrorMessage</div>
                <button class="button" @onclick="FixWithAiAsync" disabled="@(isRunning || isAssistantBusy)">Fix with AI</button>
            </div>
        }

        @if (Session.Result != null && Session.Result.Success)
        {
            <div class="results-section">
                <div class="pane-header">
                    <h2>Results</h2>
                    <div class="pane-actions">
                        @if (Session.Result.Table != null)
                        {
                            <button class="button" @onclick="DownloadCsvAsync" disabled="@isAssistantBusy">Download CSV</button>
                        }
                        <button class="button" @onclick="DownloadXmlAsync" disabled="@isAssistantBusy">Download XML</button>
                    </div>
                </div>

                @if (Session.Result.Table != null)
                {
                    <ResultsTable Table="Session.Result.Table" />
                }
                else
                {
                    <p class="results-note">
                        The response is not in the tabular report format — showing the raw XML instead.
                        Ask the assistant to restructure the query using the tabular output pattern to get a downloadable table.
                    </p>
                    <pre class="raw-xml">@Session.Result.RawXml</pre>
                }
            </div>
        }
    </section>
</div>

@code {
    private ChatPanel? chatPanel;

    private bool isRunning;

    private bool isSaving;

    private bool isAssistantBusy;

    private bool restored;

    private string? saveStatus;

    private bool saveStatusIsError;

    [SupplyParameterFromQuery(Name = "template")]
    public string? Template { get; set; }

    [SupplyParameterFromQuery(Name = "saved")]
    public string? SavedReportId { get; set; }

    [SupplyParameterFromQuery(Name = "new")]
    public bool StartNew { get; set; }

    private string QueryXml
    {
        get => this.Session.QueryXml;
        set => this.Session.QueryXml = value;
    }

    protected override void OnInitialized()
    {
        // Re-save (debounced) whenever any part of the session changes — query edits, variable edits,
        // chat turns and run results all flow through Session.Changed.
        this.Session.Changed += this.OnSessionChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Restore the persisted Standard/Advanced preference before any early return below — the
        // toggle must reflect the saved mode on every entry path into this page.
        var modeRestored = await this.ModeStore.TryRestoreAsync();

        // "New blank report" arrives as ?new=true: discard any in-memory session and persisted draft
        // so the user genuinely starts fresh rather than resuming their last query.
        if (this.StartNew)
        {
            this.Session.Restore(new ReportSessionSnapshot());
            await this.SessionStore.ClearAsync();
            this.StateHasChanged();
            return;
        }

        // An explicit "Open report" (?template= or ?saved=) always wins: the user picked a report on
        // the Reports page, so it replaces both the in-memory session and the persisted draft (the
        // session reset raises no Changed event; the query assignment that follows schedules the
        // draft save that overwrites the old one).
        if (!string.IsNullOrEmpty(this.Template) && CommonReportCatalog.FindByKey(this.Template) is { } template)
        {
            this.Session.Restore(new ReportSessionSnapshot());
            this.Session.QueryXml = template.QueryXml;
        }
        else if (!string.IsNullOrEmpty(this.SavedReportId))
        {
            // Loads the report definition from the API with the user's own credentials, so
            // permissions apply and the designer edits the wrapped query directly.
            this.Session.Restore(new ReportSessionSnapshot());
            await this.LoadSavedReportAsync(this.SavedReportId);
        }
        else if (this.Session.IsEmpty)
        {
            // JS interop (and thus localStorage) is only available after the first interactive
            // render, so the draft restore runs here rather than in OnInitialized/OnParametersSet.
            this.restored = await this.SessionStore.TryRestoreAsync(this.Session);
        }

        if (modeRestored || this.restored || !this.Session.IsEmpty)
        {
            this.StateHasChanged();
        }
    }

    private async Task ToggleModeAsync(ChangeEventArgs e)
    {
        var advanced = e.Value is bool isChecked && isChecked;

        await this.ModeStore.SetModeAsync(advanced ? DesignerMode.Advanced : DesignerMode.Standard);
    }

    private void OnSessionChanged()
    {
        this.SessionStore.ScheduleSave(this.Session);
        this.InvokeAsync(this.StateHasChanged);
    }

    private async Task RunQueryAsync()
    {
        this.isRunning = true;
        this.Session.SetResult(null, null, sessionExpired: false);

        try
        {
            var result = await this.QueryService.ExecuteQueryAsync(this.Session.QueryXml);

            this.Session.SetResult(result, result.Success ? null : result.ErrorMessage, sessionExpired: false);
        }
        catch (ApiTokenUnavailableException exception)
        {
            this.Session.SetResult(null, exception.Message, sessionExpired: true);
        }
        catch (Exception exception)
        {
            this.Session.SetResult(null, $"Query execution failed: {exception.Message}", sessionExpired: false);
        }
        finally
        {
            this.isRunning = false;
        }
    }

    private async Task LoadSavedReportAsync(string reportId)
    {
        try
        {
            var report = await this.ReportDefinitions.LoadReportAsync(reportId);

            this.Session.QueryXml = report.QueryXml;
            this.Session.SavedReportId = report.Id;
            this.Session.ReportName = report.Name;
        }
        catch (ApiTokenUnavailableException exception)
        {
            this.Session.SetResult(null, exception.Message, sessionExpired: true);
        }
        catch (ReportPersistenceException exception)
        {
            this.Session.SetResult(null, $"The saved report could not be loaded: {exception.Message}", sessionExpired: false);
        }
        catch (HttpRequestException exception)
        {
            this.Session.SetResult(null, $"The saved report could not be loaded: {exception.Message}", sessionExpired: false);
        }
    }

    private async Task SaveReportAsync()
    {
        var name = this.Session.ReportName.Trim();

        if (name.Length == 0 || string.IsNullOrWhiteSpace(this.Session.QueryXml))
        {
            return;
        }

        this.isSaving = true;
        this.saveStatus = null;

        try
        {
            if (this.Session.SavedReportId == null)
            {
                this.Session.SavedReportId = await this.ReportDefinitions.CreateReportAsync(name, this.Session.QueryXml);
            }
            else
            {
                await this.ReportDefinitions.UpdateReportAsync(this.Session.SavedReportId, name, this.Session.QueryXml);
            }

            this.saveStatus = $"Saved to your PayRun.io account at {DateTime.Now:HH:mm}.";
            this.saveStatusIsError = false;
        }
        catch (ApiTokenUnavailableException exception)
        {
            this.Session.SetResult(null, exception.Message, sessionExpired: true);
        }
        catch (ReportPersistenceException exception)
        {
            this.saveStatus = exception.Message;
            this.saveStatusIsError = true;
        }
        catch (HttpRequestException exception)
        {
            this.saveStatus = exception.Message;
            this.saveStatusIsError = true;
        }
        finally
        {
            this.isSaving = false;
        }
    }

    private void ApplyQueryFromChat(string xml)
    {
        this.Session.QueryXml = xml.Trim();
    }

    private void OnAssistantBusyChanged(bool busy)
    {
        this.isAssistantBusy = busy;
    }

    private void UpdateVariable(string name, string value)
    {
        this.Session.SetVariable(name, value);
    }

    private async Task SignInAgainAsync()
    {
        // The sign-in redirect is a full-page navigation that tears down this circuit, so a pending
        // debounced save would be lost. Force the draft to disk first, then navigate, so the
        // in-progress query survives the OIDC round-trip and is restored on return.
        await this.SessionStore.FlushSaveAsync(this.Session);

        this.Navigation.NavigateTo("auth/login?returnUrl=%2Freport", forceLoad: true);
    }

    private async Task FixWithAiAsync()
    {
        if (this.chatPanel != null)
        {
            await this.chatPanel.SendPromptAsync(
                "The report query failed to execute. Please diagnose the error, correct the query and reply with the full corrected RQL.");
        }
    }

    private async Task DownloadCsvAsync()
    {
        if (this.Session.Result?.Table == null)
        {
            return;
        }

        await this.JsRuntime.InvokeVoidAsync(
            "reportBuilder.downloadFile",
            $"report-{DateTime.Now:yyyyMMdd-HHmmss}.csv",
            "text/csv",
            CsvExporter.ToCsv(this.Session.Result.Table));
    }

    private async Task DownloadXmlAsync()
    {
        if (this.Session.Result == null)
        {
            return;
        }

        await this.JsRuntime.InvokeVoidAsync(
            "reportBuilder.downloadFile",
            $"report-{DateTime.Now:yyyyMMdd-HHmmss}.xml",
            "application/xml",
            this.Session.Result.RawXml);
    }

    public void Dispose()
    {
        this.Session.Changed -= this.OnSessionChanged;
    }

    private static string TrimBrackets(string name) => name.Trim('[', ']');
}
