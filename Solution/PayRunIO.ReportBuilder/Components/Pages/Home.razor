@page "/"
@attribute [Authorize]
@inject ReportSessionStore SessionStore
@inject ReportDefinitionService ReportDefinitions

<PageTitle>Reports — PayRun.io Report Builder</PageTitle>

<h1>Custom report builder</h1>
<p class="lede">
    Describe the tabular payroll report you need in plain language, refine it with the AI assistant,
    run it against the PayRun.io API with your own credentials, and download the results.
</p>

<div class="report-cards">
    @if (hasDraft)
    {
        <div class="report-card continue-report">
            <h2>Continue where you left off</h2>
            <p>Return to the report query you were working on — your query, parameters and assistant conversation are restored.</p>
            <a class="button primary" href="report">Continue current query</a>
        </div>
    }
    <div class="report-card new-report">
        <h2>New blank report</h2>
        <p>Start from scratch — tell the assistant what data you need and it will build the report query for you.</p>
        <a class="button @(hasDraft ? "" : "primary")" href="report?new=true">Create report</a>
    </div>
    @foreach (var template in CommonReportCatalog.All)
    {
        <div class="report-card">
            <h2>@template.Name</h2>
            <p>@template.Description</p>
            <a class="button" href="report?template=@template.Key">Open report</a>
        </div>
    }
</div>

<h2 class="saved-reports-heading">Your saved reports</h2>
@if (savedReportsError != null)
{
    <p class="saved-reports-status error">Your saved reports could not be loaded: @savedReportsError</p>
}
else if (savedReports == null)
{
    <p class="saved-reports-status">Loading your saved reports…</p>
}
else if (savedReports.Count == 0)
{
    <p class="saved-reports-status">
        No saved reports yet — open the designer, build a report and press "Save report" to store it
        in your PayRun.io account.
    </p>
}
else
{
    <div class="report-cards">
        @foreach (var report in savedReports)
        {
            <div class="report-card saved-report">
                <h2>@report.Name</h2>
                <p>A report saved in your PayRun.io account. Open it to run, refine or save changes.</p>
                <a class="button" href="report?saved=@Uri.EscapeDataString(report.Id)">Open report</a>
            </div>
        }
    </div>
}

@code {
    private bool hasDraft;

    private IReadOnlyList<SavedReportSummary>? savedReports;

    private string? savedReportsError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // localStorage is only reachable after the first interactive render.
        hasDraft = await this.SessionStore.HasDraftAsync();

        if (hasDraft)
        {
            this.StateHasChanged();
        }

        // Resolve the managed ("ReportBuilder-" prefixed) report definitions with the user's own API
        // credentials, so the list reflects what this user is permitted to see.
        try
        {
            savedReports = await this.ReportDefinitions.ListManagedReportsAsync();
        }
        catch (ApiTokenUnavailableException)
        {
            savedReportsError = "your session has expired — sign out and back in to see them.";
        }
        catch (ReportPersistenceException exception)
        {
            savedReportsError = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            savedReportsError = exception.Message;
        }

        this.StateHasChanged();
    }
}
