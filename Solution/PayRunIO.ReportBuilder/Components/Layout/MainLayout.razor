@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <div class="app-title">
            <span class="brand">PayRun.io</span> Report Builder
        </div>
        <nav class="app-nav">
            <NavLink href="" Match="NavLinkMatch.All">Reports</NavLink>
            <NavLink href="report">Designer</NavLink>
        </nav>
        <div class="user-info">
            <AuthorizeView>
                <Authorized>
                    <span class="user-name">@context.User.Identity?.Name</span>
                    <a class="sign-out" href="auth/logout">Sign out</a>
                </Authorized>
            </AuthorizeView>
        </div>
    </header>
    <main class="app-main">
        @Body
    </main>
</div>
