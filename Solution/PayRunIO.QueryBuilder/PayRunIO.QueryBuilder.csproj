<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>

    <!-- Self contained single file, matching the other utilities. Without this the MSI
         would install successfully and then fail at launch on any machine lacking the
         .NET 8 Desktop Runtime, with no useful error. IncludeAllContentForSelfExtract
         keeps appsettings.json readable by the configuration builder at startup. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- The assembly version MUST match the version the installer advertises, because the
         update client compares the manifest's latestVersion against the running assembly's
         version. If the assembly reports an older version than the package that installed it,
         every launch is offered the update it has already applied - an endless prompt loop.

         CI passes the same value to both projects:

           dotnet publish ... -p:PackageVersion=%build.number%
           dotnet build   ... -p:PackageVersion=%build.number%   (installer)

         PackageVersion is the shared name so a single build server parameter feeds both. The
         legacy -p:BuildNumber form is still honoured for local builds, where it appends a patch
         field to VersionPrefix. BuildNumber cannot express a build number whose minor field
         moves (1.2.1234.0), which is why PackageVersion takes precedence. -->
    <VersionPrefix>1.1.0</VersionPrefix>
    <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>
    <Version Condition="'$(PackageVersion)' != ''">$(PackageVersion)</Version>
    <Version Condition="'$(Version)' == ''">$(VersionPrefix).$(BuildNumber)</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <Company>PayRun.io Ltd</Company>
    <Authors>PayRun.io Ltd</Authors>
    <Product>PayRun.io Query Builder</Product>
    <Description />
    <Copyright>Copyright © PayRun.io Ltd</Copyright>
    <ApplicationIcon>QueryBuilder.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="MahApps.Metro.IconPacks.BoxIcons" Version="6.2.1" />
    <PackageReference Include="Markdig.Wpf" Version="0.5.0.1" />
	<PackageReference Include="PayRunIO.CSharp.SDK" Version="26.27.2.94" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\PayRunIO.ConnectionControls\PayRunIO.ConnectionControls\PayRunIO.ConnectionControls.csproj" />
    <ProjectReference Include="..\PayRunIO.RqlAssistant.Service\PayRunIO.RqlAssistant.Service.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="AppSettings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>AppSettings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!--
      Kept beside the executable rather than bundled into the single file. The application
      reads it from AppDomain.CurrentDomain.BaseDirectory, which for a bundled single file
      resolves to the temporary extraction directory: an administrator editing the installed
      file would see no effect. ExcludeFromSingleFile keeps it a real, editable file, which
      is also what the installer's NeverOverwrite component expects.
    -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="AppSettings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>AppSettings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>