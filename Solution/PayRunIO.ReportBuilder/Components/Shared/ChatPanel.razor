@using System.Text.RegularExpressions
@using Markdig
@using PayRunIO.RqlAssistant.Service.Models
@inject ReportChatService ChatService
@inject IJSRuntime JsRuntime

<div class="chat-panel">
    <div class="pane-header">
        <h2>AI assistant</h2>
        <div class="pane-actions">
            <button class="button subtle" @onclick="ResetConversation" disabled="@isBusy">New conversation</button>
        </div>
    </div>

    <div class="chat-messages" @ref="messagesElement">
        @if (ChatService.History.Count == 0 && !isBusy)
        {
            <div class="chat-empty">
                <p>Describe the report you need and the assistant will build @(ShowRql ? "the RQL query" : "it") for you. For example:</p>
                <ul>
                    <li>"A report of all employees with their tax code and NI letter."</li>
                    <li>"Gross to net for employer ER005, May 2025 payment dates."</li>
                    <li>"Add a pension contributions column to the current report."</li>
                </ul>
                <p>You can also ask for help when a report fails to run — the assistant sees the current query and the last error.</p>
            </div>
        }

        @foreach (var message in ChatService.History.Where(m => m.Role != ParticipantType.Tool))
        {
            <div class="chat-message @RoleClass(message.Role)">
                <div class="chat-role">@RoleLabel(message.Role)</div>
                <div class="chat-text">@((MarkupString)this.RenderMessage(message.Text))</div>
            </div>
        }

        @if (isBusy)
        {
            <div class="chat-message assistant busy">
                <div class="chat-role">Assistant</div>
                <div class="chat-text">
                    <div class="busy-status">
                        <span class="spinner" aria-hidden="true"></span>
                        <span>@(cancelRequested ? "Cancelling…" : "Working on your report…")</span>
                    </div>
                    @if (activityLog.Count > 0)
                    {
                        <ul class="busy-activity">
                            @foreach (var (activity, isCurrent) in RecentActivity())
                            {
                                <li class="@(isCurrent ? "current" : "done")">@activity</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        }
    </div>

    <div class="chat-input">
        <textarea placeholder="Describe the report you need…"
                  @bind="draft"
                  @bind:event="oninput"
                  disabled="@isBusy"></textarea>
        @if (isBusy)
        {
            <button class="button danger"
                    @onclick="CancelRequest"
                    disabled="@cancelRequested">
                @(cancelRequested ? "Cancelling…" : "Cancel")
            </button>
        }
        else
        {
            <button class="button primary"
                    @onclick="SendDraftAsync"
                    disabled="@(string.IsNullOrWhiteSpace(draft))">
                Send
            </button>
        }
    </div>
</div>

@code {
    private static readonly MarkdownPipeline MarkdownPipeline =
        new MarkdownPipelineBuilder().UseAdvancedExtensions().DisableHtml().Build();

    // Matches the rendered HTML Markdig produces for a ```xml fence — the channel the assistant uses
    // to deliver the RQL — so it can be syntax highlighted and wrapped in a collapsible section.
    private static readonly Regex XmlCodeBlockRegex = new(
        "<pre><code class=\"language-xml\">(?<code>[\\s\\S]*?)</code></pre>",
        RegexOptions.IgnoreCase | RegexOptions.Compiled);

    /// <summary>Number of progress lines shown under the busy spinner; older lines age out so the
    /// bubble stays compact while still conveying continuous movement.</summary>
    private const int MaxVisibleActivities = 5;

    private ElementReference messagesElement;

    private string draft = string.Empty;

    private bool isBusy;

    private bool cancelRequested;

    private CancellationTokenSource? askCancellation;

    private readonly List<string> activityLog = new();

    [Parameter]
    public string? CurrentQueryXml { get; set; }

    [Parameter]
    public string? LastError { get; set; }

    /// <summary>When false (standard mode), fenced xml blocks in the transcript are wrapped in a
    /// collapsed, expandable section rather than shown open — the RQL stays reachable, just tucked
    /// away by default.</summary>
    [Parameter]
    public bool ShowRql { get; set; } = true;

    [Parameter]
    public EventCallback<string> OnQueryProduced { get; set; }

    /// <summary>Raised when the assistant starts (true) or finishes (false) a request, so the
    /// host page can deactivate the report editing surface while the agent is working.</summary>
    [Parameter]
    public EventCallback<bool> BusyChanged { get; set; }

    public async Task SendPromptAsync(string prompt)
    {
        if (this.isBusy || string.IsNullOrWhiteSpace(prompt))
        {
            return;
        }

        this.isBusy = true;
        this.cancelRequested = false;
        this.activityLog.Clear();
        this.askCancellation = new CancellationTokenSource();
        this.StateHasChanged();
        await this.BusyChanged.InvokeAsync(true);

        try
        {
            var turn = await this.ChatService.AskAsync(
                           prompt,
                           this.CurrentQueryXml,
                           this.LastError,
                           this.ReportActivity,
                           this.askCancellation.Token);

            if (turn.UpdatedQueryXml != null)
            {
                await this.OnQueryProduced.InvokeAsync(turn.UpdatedQueryXml);
            }
        }
        finally
        {
            this.askCancellation.Dispose();
            this.askCancellation = null;
            this.isBusy = false;
            this.cancelRequested = false;
            await this.BusyChanged.InvokeAsync(false);
            this.StateHasChanged();
        }
    }

    private void CancelRequest()
    {
        // Flag first so the UI flips to "Cancelling…" even if the token takes a moment to unwind
        // the in-flight HTTP call.
        this.cancelRequested = true;
        this.askCancellation?.Cancel();
    }

    /// <summary>Progress sink passed to the chat service. The agent loop runs on thread-pool
    /// threads (ConfigureAwait(false)), so marshal onto the renderer's sync context.</summary>
    private void ReportActivity(string activity) =>
        _ = this.InvokeAsync(() =>
            {
                this.activityLog.Add(activity);
                this.StateHasChanged();
            });

    /// <summary>The tail of the activity log: earlier lines render as completed, the last as current.</summary>
    private IEnumerable<(string Activity, bool IsCurrent)> RecentActivity()
    {
        var visible = this.activityLog.Count > MaxVisibleActivities
                          ? this.activityLog.GetRange(this.activityLog.Count - MaxVisibleActivities, MaxVisibleActivities)
                          : this.activityLog;

        for (var i = 0; i < visible.Count; i++)
        {
            yield return (visible[i], i == visible.Count - 1);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await this.JsRuntime.InvokeVoidAsync("reportBuilder.scrollToBottom", this.messagesElement);
    }

    private async Task SendDraftAsync()
    {
        var prompt = this.draft.Trim();

        if (prompt.Length == 0)
        {
            return;
        }

        this.draft = string.Empty;

        await this.SendPromptAsync(prompt);
    }

    private void ResetConversation()
    {
        this.ChatService.Reset();
    }

    private static string RoleClass(ParticipantType role) =>
        role switch
            {
                ParticipantType.User => "user",
                ParticipantType.Assistant => "assistant",
                _ => "system",
            };

    private static string RoleLabel(ParticipantType role) =>
        role switch
            {
                ParticipantType.User => "You",
                ParticipantType.Assistant => "Assistant",
                _ => "System",
            };

    private string RenderMessage(string? text)
    {
        var effective = text ?? string.Empty;

        // The markdown pipeline has DisableHtml(), so raw <details> markup can't be spliced into the
        // markdown source — it would be escaped, not passed through. Instead, render the whole
        // message first (fences become ordinary <pre><code class="language-xml"> blocks), then wrap
        // just those code blocks in a collapsible <details> after the fact.
        var html = Markdown.ToHtml(effective, MarkdownPipeline);

        var openAttribute = this.ShowRql ? " open" : string.Empty;

        return XmlCodeBlockRegex.Replace(
            html,
            match =>
                {
                    // Markdig HTML-encoded the fence body; decode back to raw XML so the highlighter
                    // can tokenise it (it re-encodes every token on output).
                    var xml = System.Net.WebUtility.HtmlDecode(match.Groups["code"].Value);

                    return $"<details class=\"rql-expando\"{openAttribute}><summary>RQL query</summary>"
                           + $"<pre><code class=\"language-xml\">{XmlSyntaxHighlighter.ToHtml(xml)}</code></pre></details>";
                });
    }
}
