<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    Per user installation. The package installs under the local application data folder so
    that neither the initial install nor an in application upgrade raises an elevation
    prompt, and administrators do not need local administrator rights.

    UpgradeCode identifies the product across all of its versions and must never change:
    it is what allows a newer package to replace an installed one. ProductCode is left to
    be generated per build, which a MajorUpgrade requires.
  -->
  <Package Name="PayRun.io Query Builder"
           Manufacturer="PayRun.io Ltd"
           Version="$(ProductVersion)"
           UpgradeCode="5C41A2E9-0F80-4DB6-A49E-6BB156F0E7E8"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(ProjectRoot)QueryBuilder.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://developer.payrun.io/docs/downloads/index.html" />

    <!-- Records the install path against the Add/Remove Programs entry, which otherwise
         reports no location. Set through SetProperty rather than a plain Property because
         [INSTALLFOLDER] only resolves once directory costing has run, hence After. The
         browse page can retarget INSTALLFOLDER, so this picks up whatever the user chose. -->
    <SetProperty Id="ARPINSTALLLOCATION"
                 Value="[INSTALLFOLDER]"
                 After="CostFinalize" />

    <!--
      Every stock WiX dialog set presents a licence agreement page, and with no licence file
      supplied it displays the WiX placeholder text. There is no licence to present for an
      internal utility, so the Welcome page is repointed straight at the confirmation page
      and LicenseAgreementDlg is left unreachable.
    -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <!-- PayRun.io branded artwork replacing the stock WiX graphics. Both must be 24 bit
         BMP at the sizes Windows Installer expects: 493x312 for the side panel shown on
         the Welcome and Finish pages, 493x58 for the strip across the other pages. -->
    <WixVariable Id="WixUIDialogBmp" Value="$(AssetsRoot)DialogBanner.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="$(AssetsRoot)TopBanner.bmp" />

    <UI>
      <!-- Overrides the stock Welcome -> LicenseAgreementDlg navigation. A higher Ordering
           than the built in event wins, giving
           Welcome -> Shortcuts -> Confirm -> Install -> Finish. -->
      <Publish Dialog="WelcomeDlg"
               Control="Next"
               Event="NewDialog"
               Value="ShortcutOptionsDlg"
               Order="10"
               Condition="NOT Installed" />

      <!-- Keeps Back on the confirmation page consistent with the shortened path. -->
      <Publish Dialog="VerifyReadyDlg"
               Control="Back"
               Event="NewDialog"
               Value="ShortcutOptionsDlg"
               Order="10"
               Condition="NOT Installed" />

      <!--
        Offers the optional desktop shortcut. Authoring a new dialog is legal, unlike
        amending one from WixToolset.UI.wixext: a library dialog's Control rows are one
        indivisible symbol set and redefining it fails to link with WIX0091. See README.

        Geometry matches the stock pages so the wizard does not shift between steps:
        370x270 with the banner across the top 44 units, BottomLine at 234 and the button
        row at Y=243. Attributes 39 = Visible + Modal + Minimize + KeepModeless, and the
        dialog is only reachable on a fresh install, so no maintenance variants are needed.
      -->
      <Dialog Id="ShortcutOptionsDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44"
                 TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <!-- X=15/25 keeps the text clear of the logo pinned to the right of the banner. -->
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15"
                 Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Shortcuts" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15"
                 Transparent="yes" NoPrefix="yes"
                 Text="Choose where [ProductName] can be started from." />

        <Control Id="StartMenuText" Type="Text" X="25" Y="65" Width="320" Height="15"
                 Transparent="yes" NoPrefix="yes"
                 Text="A Start menu entry is always created under PayRun.io." />

        <!--
          The checkbox is 12x12 with its caption in a separate transparent Text control.
          Windows Installer never applies the transparent window style to a checkbox, so a
          full width control paints a grey block over the white part of the banner area.
          Authoring it this way here avoids needing a second post-build fix-up: only
          ExitDialog, whose checkbox belongs to the imported dialog set, still needs one.
          See Fix-ExitDialogCheckBox.ps1 and the README.
        -->
        <Control Id="DesktopShortcutCheckBox" Type="CheckBox" X="25" Y="90" Width="12" Height="12"
                 Property="INSTALLDESKTOPSHORTCUT" CheckBoxValue="1" />
        <Control Id="DesktopShortcutLabel" Type="Text" X="40" Y="90" Width="300" Height="17"
                 Transparent="yes" NoPrefix="yes"
                 Text="Create a shortcut on the desktop" />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Text="&amp;Back">
          <Publish Event="NewDialog" Value="WelcomeDlg" />
        </Control>
        <!--
          Leaving the page records the answer as an explicit 0 or 1 rather than the empty
          string an unticked checkbox leaves behind. This is what makes the wizard's answer
          survive into the execute sequence: the seeding actions treat an empty property as
          "not yet decided" and apply the default of 1, so an unticked box would otherwise
          be indistinguishable from no choice at all and the shortcut would be created
          anyway. Silent installs never hit this, because they pass a non-empty value.

          Both events are ordered before the NewDialog so the property is set while the
          dialog is still current.
        -->
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Default="yes" Text="&amp;Next">
          <Publish Property="INSTALLDESKTOPSHORTCUT" Value="0" Order="1"
                   Condition="NOT INSTALLDESKTOPSHORTCUT" />
          <Publish Property="INSTALLDESKTOPSHORTCUT" Value="1" Order="2"
                   Condition="INSTALLDESKTOPSHORTCUT = 1" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="3" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- Runs the launch action only when the user leaves the checkbox ticked, and only on
           a fresh install or upgrade rather than on repair or uninstall. -->
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <!-- Offer to start the application from the final page of the installer. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
              Value="Launch PayRun.io Query Builder" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <!--
      Drives the optional desktop shortcut. Public (upper case) so it survives the
      InstallUISequence -> InstallExecuteSequence boundary and can be set for a silent
      install: msiexec /i ... INSTALLDESKTOPSHORTCUT=0

      Deliberately declared with no value. The default of 1 is applied by
      DefaultDesktopShortcut below, conditioned on the property being empty, so that an
      explicit command line value is never overwritten. Giving it a value here instead
      makes a command line 0 indistinguishable from the default at the point the seeding
      actions run, and the carry-forward action then stamps it back to 1. That is what an
      earlier revision did, silently ignoring INSTALLDESKTOPSHORTCUT=0 on an upgrade.

      An unticked checkbox sets the property to nothing rather than 0, hence the component
      condition tests for "= 1" rather than for absence.
    -->
    <Property Id="INSTALLDESKTOPSHORTCUT" Secure="yes" />

    <!--
      Carries the previous choice across a major upgrade. Without this the property falls
      back to its default on every update, so a user who declined the desktop shortcut has
      one appear again on the next release, and the reinstall of a component whose
      condition has flipped is what decides whether the shortcut is added or removed.

      The registry value is the desktop component's key path, written only while that
      component is installed, so its presence is exactly the previous answer. The upgrade
      runs the UI, so the wizard shows the box already reflecting the installed state.
    -->
    <Property Id="DESKTOPSHORTCUTINSTALLED">
      <RegistrySearch Id="SearchDesktopShortcut"
                      Root="HKCU"
                      Key="Software\PayRun.io\QueryBuilder"
                      Name="desktopShortcut"
                      Type="raw" />
    </Property>

    <!--
      Distinguishes "declined the shortcut" from "installed before the shortcut existed".
      Both leave no desktopShortcut value, but they must behave differently: a declined
      shortcut should stay declined, whereas an upgrade from a release that never offered
      one should get the default like a first install, rather than silently opting the user
      out of a feature they were never shown.

      This value is written by the desktop shortcut's sibling component below and so exists
      on any install that offered the choice, whichever way it was answered.
    -->
    <Property Id="SHORTCUTCHOICERECORDED">
      <RegistrySearch Id="SearchShortcutChoiceRecorded"
                      Root="HKCU"
                      Key="Software\PayRun.io\QueryBuilder"
                      Name="shortcutChoiceRecorded"
                      Type="raw" />
    </Property>

    <!--
      Carries a previous install's answer into this one, so an upgrade neither reinstates a
      shortcut the user declined nor drops one they asked for.

      Every action below is conditioned on INSTALLDESKTOPSHORTCUT being empty, which is what
      makes an explicitly supplied value authoritative: the property is declared with no
      value, so it is empty unless the command line or the wizard checkbox set it, and none
      of this seeding can then overwrite a deliberate choice. Dropping that guard is how an
      earlier revision came to ignore INSTALLDESKTOPSHORTCUT=0 on an upgrade.

      All three must run after AppSearch, which is what populates the registry searches.
      FindRelatedProducts is sequenced at 25 and AppSearch at 50, so scheduling against
      FindRelatedProducts would test a search result before the search had run.

      Note this only carries the answer for a silent upgrade. When the UI runs, the wizard
      shows the checkbox seeded from these same properties and whatever the user leaves it
      set to wins, because the checkbox writes the property directly.
    -->
    <SetProperty Id="INSTALLDESKTOPSHORTCUT"
                 Action="KeepDesktopShortcutFromPreviousInstall"
                 Value="1"
                 After="AppSearch"
                 Sequence="both"
                 Condition="NOT INSTALLDESKTOPSHORTCUT AND DESKTOPSHORTCUTINSTALLED" />

    <!--
      A declined shortcut leaves no desktopShortcut value, which is indistinguishable from a
      release predating the feature unless the marker is consulted: SHORTCUTCHOICERECORDED
      gates this to installs that actually offered the choice, so an upgrade from an older
      release still gets the default rather than being silently opted out.

      This sets the property to a literal 0 rather than clearing it, so that the default
      below can tell "decided against" from "not yet decided". The component condition tests
      for "= 1", so 0 and empty both suppress the shortcut.
    -->
    <SetProperty Id="INSTALLDESKTOPSHORTCUT"
                 Action="DropDesktopShortcutFromPreviousInstall"
                 Value="0"
                 After="KeepDesktopShortcutFromPreviousInstall"
                 Sequence="both"
                 Condition="NOT INSTALLDESKTOPSHORTCUT AND WIX_UPGRADE_DETECTED AND SHORTCUTCHOICERECORDED AND NOT DESKTOPSHORTCUTINSTALLED" />

    <!-- Applies the default of ticked to everything the two actions above left undecided: a
         first install, or an upgrade from a release that predates the feature. Authored as
         an action rather than a value on the Property element so that it runs after the
         command line has been seen, leaving an explicit 0 intact. -->
    <SetProperty Id="INSTALLDESKTOPSHORTCUT"
                 Action="DefaultDesktopShortcut"
                 Value="1"
                 After="DropDesktopShortcutFromPreviousInstall"
                 Sequence="both"
                 Condition="NOT INSTALLDESKTOPSHORTCUT" />

    <!-- WixShellExecTarget identifies what the launch action starts. It is resolved from the
         installed file rather than a hard coded path so it follows INSTALLFOLDER. -->
    <Property Id="WixShellExecTarget" Value="[#QueryBuilderExe]" />

    <CustomAction Id="LaunchApplication"
                  BinaryRef="Wix4UtilCA_X86"
                  DllEntry="WixShellExec"
                  Impersonate="yes" />

    <!-- Every PayRun.io utility installs beneath a shared PayRunIO folder so the suite
         occupies one location in the user profile rather than a folder per product. Only
         the product folder inside it belongs to this package: the shared parent is left
         for whichever utility happens to be uninstalled last, see RemoveFolder below.

         The product folder is spelled QueryBuilder without a space, matching the settings
         folders the application creates under %APPDATA%\PayRunIO\QueryBuilder and the
         RqlAssistantMcp style naming used elsewhere in the suite. Unspaced names keep the
         install path, the user data path and the registry key consistent. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="SuiteFolder" Name="PayRunIO">
          <Directory Id="INSTALLFOLDER" Name="QueryBuilder" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppShortcutFolder" Name="PayRun.io" />
    </StandardDirectory>

    <!-- Per user scope resolves this to %UserProfile%\Desktop, so the shortcut needs no
         elevation. The folder is not created or removed by the package, only written to. -->
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="ShortcutChoiceMarker" />
    </Feature>
  </Package>

  <Fragment>
    <!-- The application publishes as a self contained single file, so the package
         contains one executable rather than a harvested folder of assemblies.

         A component installing into the user profile must take its key path from an HKCU
         registry value rather than from the file, and the profile directories it creates
         must be registered for removal so that uninstall leaves nothing behind. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <!-- Explicit GUID: a component combining a file with a registry key path cannot use
           an automatically generated one. It must remain stable across releases. -->
      <Component Id="MainExecutable" Guid="45CC3CE8-23DB-4836-B00F-2BB2F3FF013A">
        <File Id="QueryBuilderExe"
              Source="$(PublishRoot)PayRunIO.QueryBuilder.exe" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <!-- The shared suite folder is removed only if this is the last utility to go:
             RemoveFolder deletes a directory only when it is empty, so it is a no-op while
             a sibling product remains installed. ProgramsFolder is likewise only removed
             when nothing else is left in it, and ICE64 requires every profile directory the
             package creates to be listed here regardless. -->
        <RemoveFolder Id="RemoveSuiteFolder" Directory="SuiteFolder" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\PayRun.io\QueryBuilder"
                       Name="version"
                       Type="string"
                       Value="$(ProductVersion)"
                       KeyPath="yes" />
      </Component>

      <!--
        Unlike the other utilities, Query Builder ships a loose appsettings.json beside the
        executable and loads it with optional:false, so the application will not start
        without it.

        NeverOverwrite preserves administrator edits across an upgrade. Permanent is required
        alongside it: a major upgrade removes the old product before installing the new one,
        and without Permanent the file is deleted by that removal and then skipped by the
        install because the component is marked never-overwrite, leaving the application
        unable to start. Permanent keeps the file in place so the edited copy survives.

        The consequence is that new default settings added in a later release do not reach
        existing installations, so any new key must be handled as absent by the application.
        The file is also deliberately left behind on uninstall.

        Moving the install location requires changing both the GUID and the registry key
        path below. NeverOverwrite is evaluated against the component's key path, and that
        key path is this registry value rather than the file: Windows Installer records the
        component's location as 01:\Software\PayRun.io\QueryBuilder\Locations\... and never
        looks at the folder. Leave the key path unchanged across a move and the value
        survives from the previous install, because Permanent exempts it from removal, so
        the component is judged already installed, the file is skipped, and the application
        starts with no appsettings.json to read. Changing the GUID alone does not help.

        Naming the subkey after the install location ties the two together, so a folder
        change invalidates the key path and the file installs.
      -->
      <Component Id="AppSettings"
                 Guid="60311A72-E3F6-42C3-BD79-1A8C0D491D55"
                 NeverOverwrite="yes"
                 Permanent="yes">
        <File Id="AppSettingsJson" Source="$(PublishRoot)appsettings.json" />
        <!-- A per user component requires an HKCU registry key path. The subkey names the
             install location so that relocating the product invalidates it, see above. -->
        <RegistryValue Root="HKCU"
                       Key="Software\PayRun.io\QueryBuilder\Locations\PayRunIO_QueryBuilder"
                       Name="settingsInstalled"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Component Id="StartMenuShortcut"
               Directory="AppShortcutFolder"
               Guid="90C8E3A3-0C1A-45BA-A0E3-E04CD2EABA64">
      <Shortcut Id="QueryBuilderShortcut"
                Name="PayRun.io Query Builder"
                Target="[INSTALLFOLDER]PayRunIO.QueryBuilder.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />
      <RemoveFolder Id="RemoveAppShortcutFolder" Directory="AppShortcutFolder" On="uninstall" />
      <!-- A per user component requires an HKCU registry key path. -->
      <RegistryValue Root="HKCU"
                     Key="Software\PayRun.io\QueryBuilder"
                     Name="installed"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <!--
      The optional desktop shortcut, offered by ShortcutOptionsDlg and controlled by
      INSTALLDESKTOPSHORTCUT. The condition is evaluated per install, so clearing the box on
      a later upgrade removes an existing shortcut rather than leaving it orphaned.

      Note there is deliberately no taskbar equivalent. Taskbar pinning has not been
      programmable since Windows 7: the taskbarpin verb was removed from the shell, and the
      pinned list is validated against a hash under HKCU\...\Taskband, so a shortcut written
      into the User Pinned\TaskBar folder is discarded by Explorer. The supported route is
      TaskbarLayoutModification.xml, which is machine wide Group Policy applied at logon and
      needs administrator rights, so it does not fit a per user package. Pinning is left to
      the user.
    -->
    <Component Id="DesktopShortcut"
               Directory="DesktopFolder"
               Guid="1378F758-B2B5-473F-93AB-3D3B16DC122E"
               Condition="INSTALLDESKTOPSHORTCUT = 1">
      <Shortcut Id="QueryBuilderDesktopShortcut"
                Name="PayRun.io Query Builder"
                Target="[INSTALLFOLDER]PayRunIO.QueryBuilder.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />
      <!-- A per user component requires an HKCU registry key path. This value is also what
           DESKTOPSHORTCUTINSTALLED searches for, so the previous choice is carried across an
           upgrade: it exists only while the component is installed. -->
      <RegistryValue Root="HKCU"
                     Key="Software\PayRun.io\QueryBuilder"
                     Name="desktopShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!--
      Records that this install offered the shortcut choice at all, which the desktop
      component above cannot do: it is conditional, so its absence is ambiguous between a
      declined shortcut and a release that predates the feature. This component is
      unconditional, so the marker is present either way, and SHORTCUTCHOICERECORDED can
      tell the two apart on a later upgrade.
    -->
    <Component Id="ShortcutChoiceMarker"
               Directory="INSTALLFOLDER"
               Guid="D4F1B0C8-6E1A-4A2C-9F3D-7B5E8C0A1D62">
      <RegistryValue Root="HKCU"
                     Key="Software\PayRun.io\QueryBuilder"
                     Name="shortcutChoiceRecorded"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Fragment>

</Wix>
