<?xml version="1.0" encoding="utf-8"?>
<log4net>
	<appender name="DebugAppender" type="log4net.Appender.DebugAppender">
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%logger - %message%newline"/>
		</layout>
	</appender>
	<appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
		<!-- Note: Remove below [Threshold] to see all levels of logging in console window -->
		<threshold value="DEBUG"/>
		<!-- Level and logger name are included so the verbose assistant events can be told apart at
		     a glance from the failure events; messages are multi-line by design (diagnostic detail,
		     query XML and prompt text all render inline). -->
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date{HH:mm:ss.fff} [%-5level] %logger{1} - %message%newline"/>
		</layout>
	</appender>
	<!-- The sourceToken, endpoint, service and environment values are overwritten at start up from
	     the BetterStack section of appsettings.json. Left as "not-set" here so the committed config
	     carries no credentials; when the token is absent the appender is dropped entirely. -->
	<appender name="BetterStackAppender" type="PayRunIO.Logging.BetterStack.BetterStackLog4NetAppender, PayRunIO.Logging.BetterStack">
		<sourceToken value="not-set"/>
		<endpoint value="not-set"/>
		<service value="not-set" />
		<environment value="not-set"/>
		<includeDiagnostics value="true"/>
		<maxQueueSize value="10000"/>
		<batchSize value="100"/>
		<flushPeriodMilliseconds value="2000"/>
		<httpTimeoutSeconds value="10"/>
		<retryCount value="3"/>
		<retryBaseDelayMilliseconds value="500"/>
		<verboseInternalErrors value="true"/>
		<hostnameLayout type="log4net.Layout.PatternLayout" value="%P{log4net:HostName}" />
		<layout type="log4net.Layout.PatternLayout" value="%-20P{pinfo} - [%-3thread] [%-5level] - %message" />
	</appender>
	<root>
		<level value="INFO"/>
		<appender-ref ref="DebugAppender"/>
		<appender-ref ref="ConsoleAppender"/>
	</root>
	<!-- Application diagnostics: query failures, assistant failures and validation gaps.
	     DEBUG rather than INFO: the assistant conversation transcript below is logged at debug, and
	     a logger level of INFO here would discard those events before any appender saw them. -->
	<logger name="PayRunIO.ReportBuilder">
		<level value="DEBUG"/>
		<appender-ref ref="BetterStackAppender"/>
	</logger>
	<!-- The full text of every prompt and reply. High volume and verbose by design: it exists to
	     build the evidence base for improving the assistant's grounding data, pairing each failure
	     with the exchange that produced it. Raise to INFO to silence the transcript while leaving
	     the failure events under PayRunIO.ReportBuilder untouched. -->
	<logger name="PayRunIO.ReportBuilder.Conversation">
		<level value="DEBUG"/>
	</logger>
	<!-- Framework noise stays out of BetterStack; warnings and above still reach the console. -->
	<logger name="Microsoft">
		<level value="WARN"/>
	</logger>
	<logger name="System">
		<level value="WARN"/>
	</logger>
</log4net>
