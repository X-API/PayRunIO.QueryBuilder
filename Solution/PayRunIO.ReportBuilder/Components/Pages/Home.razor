@page "/"
@attribute [Authorize]
@inject ReportSessionStore SessionStore
@inject LocalReportStore LocalReports
@inject ReportDefinitionService ReportDefinitions
@inject NavigationManager Navigation

<PageTitle>Reports — PayRun.io Report Builder</PageTitle>

<h1>Custom report builder</h1>
<p class="lede">
    Describe the tabular payroll report you need in plain language, refine it with the AI assistant,
    run it against the PayRun.io API with your own credentials, and download the results.
</p>

<div class="report-cards">
    @if (hasDraft)
    {
        <div class="report-card continue-report">
            <h2>Continue where you left off</h2>
            <p>Return to the report query you were working on — your query, parameters and assistant conversation are restored.</p>
            <a class="button primary" href="report">Continue current query</a>
        </div>
    }
    <div class="report-card new-report">
        <h2>New blank report</h2>
        <p>Start from scratch — tell the assistant what data you need and it will build the report query for you.</p>
        <a class="button @(hasDraft ? "" : "primary")" href="report?new=true">Create report</a>
    </div>
    @foreach (var template in CommonReportCatalog.All)
    {
        <div class="report-card">
            <h2>@template.Name</h2>
            <p>@template.Description</p>
            <a class="button" href="report?template=@template.Key">Open report</a>
        </div>
    }
</div>

<h2 class="saved-reports-heading">Your saved reports</h2>
<p class="saved-reports-status">
    Saved privately in this browser — only you can see them. Clearing your browser storage removes them.
</p>
@if (localReports == null)
{
    <p class="saved-reports-status">Loading your saved reports…</p>
}
else if (localReports.Count == 0)
{
    <p class="saved-reports-status">
        No saved reports yet — open the designer, build a report and press "Save report" to keep it here.
    </p>
}
else
{
    <div class="report-cards">
        @foreach (var report in localReports)
        {
            <div class="report-card saved-report">
                <h2>@report.Name</h2>
                <p>
                    Saved @report.UpdatedUtc.ToLocalTime().ToString("d MMM yyyy HH:mm").
                    @if (report.PublishedReportId != null)
                    {
                        <span class="published-flag" title="This report has also been published to your PayRun.io account, where everyone can see it.">Also published</span>
                    }
                </p>
                @if (pendingDeleteId == report.Id)
                {
                    <div class="delete-confirm">
                        <span>Delete "@report.Name" permanently? This cannot be undone.</span>
                        <div class="card-actions">
                            <button class="button danger" @onclick="() => ConfirmDeleteAsync(report.Id)">Delete report</button>
                            <button class="button subtle" @onclick="CancelDelete">Cancel</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card-actions">
                        <a class="button" href="report?local=@Uri.EscapeDataString(report.Id)">Open report</a>
                        <button class="button subtle" @onclick="() => RequestDelete(report.Id)">Delete</button>
                    </div>
                }
            </div>
        }
    </div>
}

<h2 class="saved-reports-heading">Published reports</h2>
<p class="saved-reports-status">
    Report definitions stored in your PayRun.io account. These are <strong>visible to everyone</strong>
    — publish from the designer in advanced mode.
</p>
@if (sessionExpired)
{
    <div class="banner error">
        <div class="banner-text">Your saved reports could not be loaded: your session has expired — sign in again to see them.</div>
        <button class="button" @onclick="() => SignInAgain(federated: false)">Sign in again</button>
        <button class="button" @onclick="() => SignInAgain(federated: true)">Sign in with Microsoft</button>
    </div>
}
else if (savedReportsError != null)
{
    <p class="saved-reports-status error">Your saved reports could not be loaded: @savedReportsError</p>
}
else if (savedReports == null)
{
    <p class="saved-reports-status">Loading published reports…</p>
}
else if (savedReports.Count == 0)
{
    <p class="saved-reports-status">
        No published reports yet — build a report, switch the designer to advanced mode and press
        "Publish report" to share it through your PayRun.io account.
    </p>
}
else
{
    <div class="report-cards">
        @foreach (var report in savedReports)
        {
            <div class="report-card saved-report published-report">
                <h2>@report.Name</h2>
                <p>Published in your PayRun.io account and visible to everyone.</p>
                <a class="button" href="report?saved=@Uri.EscapeDataString(report.Id)">Open report</a>
            </div>
        }
    </div>
}

@code {
    private bool hasDraft;

    private bool sessionExpired;

    private IReadOnlyList<SavedReportSummary>? savedReports;

    private IReadOnlyList<LocalReport>? localReports;

    /// <summary>Id of the report whose delete confirmation is currently showing; null when none is
    /// armed. Only one at a time — arming a second replaces the first.</summary>
    private string? pendingDeleteId;

    private string? savedReportsError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // localStorage is only reachable after the first interactive render.
        hasDraft = await this.SessionStore.HasDraftAsync();
        localReports = await this.LocalReports.ListAsync();

        this.StateHasChanged();

        // Resolve the managed ("ReportBuilder-" prefixed) report definitions with the user's own API
        // credentials, so the list reflects what this user is permitted to see.
        try
        {
            savedReports = await this.ReportDefinitions.ListManagedReportsAsync();
        }
        catch (ApiTokenUnavailableException)
        {
            sessionExpired = true;
        }
        catch (ReportPersistenceException exception)
        {
            savedReportsError = exception.Message;
        }
        catch (HttpRequestException exception)
        {
            savedReportsError = exception.Message;
        }

        this.StateHasChanged();
    }

    /// <summary>Arms the inline confirmation for a report. Deleting a locally saved report destroys the
    /// only copy — unlike a published report there is no server-side original to re-open — so the
    /// delete button only ever arms this step and never removes anything itself.</summary>
    private void RequestDelete(string id)
    {
        pendingDeleteId = id;
    }

    private void CancelDelete()
    {
        pendingDeleteId = null;
    }

    private async Task ConfirmDeleteAsync(string id)
    {
        pendingDeleteId = null;

        await this.LocalReports.DeleteAsync(id);

        localReports = await this.LocalReports.ListAsync();
    }

    private void SignInAgain(bool federated)
    {
        // Full-page navigation through the OIDC challenge refreshes the API token; unlike the
        // designer there is no pending draft edit here, so nothing needs flushing first.
        var federatedQuery = federated ? "&federated=true" : string.Empty;

        this.Navigation.NavigateTo($"auth/login?returnUrl=%2F{federatedQuery}", forceLoad: true);
    }
}
