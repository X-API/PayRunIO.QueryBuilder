<Window x:Class="PayRunIO.QueryBuilder.AiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Query Builder - AI Settings"
        x:Name="AiSettingsWindow1"
        Height="300"
        Width="450"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Helpers/CommonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Margin="5">
            <GroupBox.Header>
                <TextBlock Style="{StaticResource GroupBoxHeaderStyle}">AI Connection</TextBlock>
            </GroupBox.Header>
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Provider:" VerticalAlignment="Center" Margin="2,2,5,2"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ProviderComboBox" VerticalAlignment="Center" Margin="0,2,0,2"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="API Key:" VerticalAlignment="Center" Margin="2,2,5,2"/>
                <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="ApiKeyBox" PasswordChar="*" VerticalAlignment="Center" Margin="0,2,0,2"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Host:" VerticalAlignment="Center" Margin="2,2,5,2"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="EndPointBox" VerticalAlignment="Center" Margin="0,2,0,2"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Model:" VerticalAlignment="Center" Margin="2,2,5,2"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="ModelBox" VerticalAlignment="Center" Margin="0,2,0,2"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Reasoning:" VerticalAlignment="Center" Margin="2,2,5,2"
                           ToolTip="Reasoning effort for OpenAI reasoning models. Leave blank for standard models."/>
                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="ReasoningEffortComboBox" VerticalAlignment="Center" Margin="0,2,0,2"
                          ToolTip="Reasoning models (GPT-5 family) require the 'OpenAI (Responses)' provider for tool use, or reasoning effort 'none' on the standard OpenAI provider. When set, temperature is not sent."/>

                <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" x:Name="StatusText" Foreground="Green" Margin="0,10,0,0" Visibility="Collapsed"/>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Click="OnSaveClick" Width="100" Margin="2,0"/>
            <Button Content="Close" Click="OnCloseClick" Width="100" Margin="2,0"/>
        </StackPanel>
    </Grid>
</Window>
